{
  "name": "aidlc-design-agent",
  "description": "AI-DLC Design Agent - delegation target for ensemble stages (UX/UI perspective: mockups, personas, user experience).",
  "prompt": "file://aidlc-design-agent.md",
  "includeMcpJson": true,
  "tools": [
    "@aws-iac",
    "@aws-mcp",
    "@aws-pricing",
    "@aws-serverless",
    "@context7",
    "read",
    "shell",
    "thinking",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "thinking"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "aidlc engine .*",
        "date -u( .*)?"
      ],
      "deniedCommands": [
        "([^\\s]*/)?rm( [^\\s]+)* -[A-Za-z]*[rR][A-Za-z]*( .*)?",
        "([^\\s]*/)?rm( [^\\s]+)* --recursive( .*)?",
        "([^\\s]*/)?git( -[^\\s]+( (\"[^\"]*\"|'[^']*'|[^\\s]+))?)* push( .*)?"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "aidlc/spaces/**"
      ]
    }
  },
  "resources": [
    "file://.kiro/agents/aidlc-design-agent.md",
    "file://.kiro/knowledge/aidlc-design-agent/*.md",
    "file://.kiro/knowledge/aidlc-shared/*.md",
    "file://aidlc/spaces/default/memory/**/*.md"
  ],
  "hooks": [
    {
      "name": "postToolUse-0",
      "trigger": "postToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "aidlc engine adapter kiro audit-and-sensors"
      },
      "timeout": 120
    },
    {
      "name": "preToolUse-0",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": {
        "type": "command",
        "command": "aidlc engine adapter kiro state-transition-guard aidlc-design-agent"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-1",
      "trigger": "preToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "aidlc engine adapter kiro review-freeze"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-2",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": {
        "type": "command",
        "command": "aidlc engine adapter kiro review-freeze"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-3",
      "trigger": "preToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "aidlc engine adapter kiro plan-approval-guard"
      },
      "timeout": 15
    },
    {
      "name": "preToolUse-4",
      "trigger": "preToolUse",
      "matcher": "execute_bash",
      "action": {
        "type": "command",
        "command": "aidlc engine adapter kiro plan-approval-guard"
      },
      "timeout": 15
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "aidlc engine *",
          "date -u *",
          "date -u"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*/rm * -*",
          "*/rm -*",
          "rm * -*",
          "rm -*",
          "*/rm * --recursive *",
          "*/rm * --recursive",
          "*/rm --recursive *",
          "*/rm --recursive",
          "rm * --recursive *",
          "rm * --recursive",
          "rm --recursive *",
          "rm --recursive",
          "*/git -* push *",
          "*/git -* push",
          "*/git push *",
          "*/git push",
          "git -* push *",
          "git -* push",
          "git push *",
          "git push"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "aidlc/spaces/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 3,
    "fingerprint": "sha256:132652dc313f4d35a2f594a96d0f946dca5fbd4aef5cdd88268eb4571a2209f7",
    "source": "sha256:c9d27340a22e0b9d1e65761cb386911a1cca5d73193b5feefd59334c6b56cfa3"
  }
}
